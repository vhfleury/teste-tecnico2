{
    "table_name": "staging_motoristas",
    "description": "Driver registry cleaned and validated (staging layer)",
    "partitioned_by": ["ingest_date"],
    "schema": [
        {
            "name": "motorista_id",
            "type": "string",
            "example": "MOT-0002",
            "treatment": "normalize"
        },
        {
            "name": "nome",
            "type": "string",
            "example": "NICOLAS SOUSA",
            "treatment": "normalize"
        },
        {
            "name": "cpf",
            "type": "string",
            "example": "795.426.108-58",
            "treatment": "cpf_is_valid"
        },
        {
            "name": "cpf",
            "type": "string",
            "example": "79542610858",
            "treatment": "normalize_cpf",
            "new_name": "cpf_normalize"
        },
        {
            "name": "cnh",
            "type": "string",
            "example": "95800408566"
        },
        {
            "name": "categoria_cnh",
            "type": "string",
            "example": "E"
        },
        {
            "name": "validade_cnh",
            "type": "date",
            "example": "2027-10-10"
        },
        {
            "name": "telefone",
            "type": "string",
            "example": "8163427352",
            "treatment": "normalize_telefone"
        },
        {
            "name": "data_admissao",
            "type": "date",
            "example": "2023-11-03"
        },
        {
            "name": "base_operacional",
            "type": "string",
            "example": "CD Recife - Jaboatão"
        },
        {
            "name": "status",
            "type": "string",
            "example": "ativo"
        },
        {
            "name": "source_file",
            "type": "string",
            "example": "/opt/airflow/data/motoristas/motoristas.json"
        },
        {
            "name": "ingested_at",
            "type": "timestamp",
            "example": "2026-07-02 12:44:15.126810"
        },
        {
            "name": "dq_observations",
            "type": "string",
            "example": "invalid_cpf;missing_admission_date"
        },
        {
            "name": "quality_ok",
            "type": "boolean",
            "example": true
        },
        {
            "name": "processed_at",
            "type": "timestamp",
            "example": "2026-07-02 12:59:38.294138"
        },
        {
            "name": "ingest_date",
            "type": "date",
            "example": "2026-07-02"
        }
    ]
}
