AIRFLOW_UID=50000
AIRFLOW_IMAGE_NAME=bigcore-airflow-pyspark:3.1.5
AIRFLOW_PROJ_DIR=./airflow
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
_PIP_ADDITIONAL_REQUIREMENTS=

# Lakehouse layout inside the Airflow containers (read by scripts/*/statics.py)
DATA_DIR=/opt/airflow/data
LAKEHOUSE_DIR=/opt/airflow/lakehouse
