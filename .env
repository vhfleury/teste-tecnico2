# Configuração do Airflow via docker-compose.
#
# No Linux, defina o UID do seu usuário para evitar arquivos como root nos volumes:
#   echo "AIRFLOW_UID=$(id -u)" >> .env
# No Windows/macOS (Docker Desktop) pode manter 50000.
AIRFLOW_UID=50000

# Imagem do Airflow
AIRFLOW_IMAGE_NAME=apache/airflow:3.1.5

# Diretório base dos volumes (dags, logs, plugins, config, data)
AIRFLOW_PROJ_DIR=.

# Credenciais do usuário admin da UI (http://localhost:8080)
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Dependências extras instaladas no startup (use SÓ para testes rápidos).
# Ex.: _PIP_ADDITIONAL_REQUIREMENTS=apache-airflow-providers-apache-spark==5.*
_PIP_ADDITIONAL_REQUIREMENTS=
